{
  "name": "vectoral-typescript",
  "private": true,
  "type": "module",
  "description": "Workspace root for the Vectoral TypeScript SDKs.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "example": "tsx examples/full-flow.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
