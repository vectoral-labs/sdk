{
  "name": "@vectoral-labs/sdk",
  "version": "0.2.0",
  "description": "Server-side TypeScript SDK for Vectoral: registration screening, inference scoring, and prompt fingerprinting.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "author": "Vectoral Labs, Inc.",
  "homepage": "https://github.com/vectoral-labs/sdk/tree/main/typescript/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/vectoral-labs/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectoral-labs/sdk.git",
    "directory": "typescript/packages/sdk"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
